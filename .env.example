# ──────────────────────────────────────────────────
# Kestrel — Environment Variables
# Copy to .env.local and fill in your values
# ──────────────────────────────────────────────────

# ─── Supabase (landing API backend) ──────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# ─── Kestrel API ─────────────────────────────────
# Base URL for the shared API (landing app serves these routes)
# Defaults: production → https://arcsuite-app.vercel.app
#           development → http://127.0.0.1:3100
ARC_SUITE_API_URL=
NEXT_PUBLIC_ARC_SUITE_API_URL=

# Per-app API keys for authenticated requests
ARC_API_KEY=
REP_API_KEY=

# Workspace isolation
ARC_WORKSPACE_ID=

# ─── Arc Testnet settlement (landing backend only) ─
# Circle Developer-Controlled Wallet credentials
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
ARC_SOURCE_WALLET_ID=
KESTREL_EXECUTION_SIGNING_SECRET=
KESTREL_APP_KIT_PRIVATE_KEY=
ARC_APP_KIT_KEY=
# Configure Circle webhook delivery to:
# https://arcsuite-app.vercel.app/api/webhooks/circle

# Full EVM address of the Circle wallet that signs Arc Testnet transfers
ARC_SOURCE_WALLET_ADDRESS=

# Transfers are rejected unless the recipient is in this server-side allowlist
ARC_SETTLEMENT_DEFAULT_RECIPIENT=
ARC_SETTLEMENT_ALLOWED_RECIPIENTS=

# Hard safety cap per transfer; defaults to 0.1 USDC
ARC_MAX_SETTLEMENT_USDC=0.1

# Circle confirmation polling; bounded by the server route timeout
ARC_SETTLEMENT_CONFIRMATION_TIMEOUT_MS=45000
ARC_SETTLEMENT_POLL_INTERVAL_MS=2000

# ─── Treasury auth ───────────────────────────────
ARC_TREASURY_ADMIN_KEY=
ARC_TREASURY_SESSION_SECRET=

# ─── Ecosystem navigation (optional) ────────────
# Falls back to production Vercel URLs if unset
NEXT_PUBLIC_ARC_TREASURY_URL=https://treasury-umber.vercel.app
NEXT_PUBLIC_ARC_REPUTATION_URL=https://reputation-swart.vercel.app
NEXT_PUBLIC_ARC_MARKETPLACE_URL=https://marketplace-eosin-eight.vercel.app

# ─── App Kit and monetization ───────────────────
# Browser-wallet App Kit execution does not require a server private key.
# Server-side execution gate. Production remains fail-closed unless enabled.
KESTREL_MONEY_EXECUTION_ENABLED=false
# The server will fall back to ARC_SOURCE_WALLET_ADDRESS when this is empty.
KESTREL_FEE_RECIPIENT=
# Per-intent cap and optional recipient allowlist. Both fall back to the
# corresponding ARC settlement values when empty.
KESTREL_MAX_MONEY_MOVEMENT_USDC=0.1
KESTREL_MONEY_ALLOWED_RECIPIENTS=
# Backward-compatible client override; server policy remains authoritative.
NEXT_PUBLIC_KESTREL_FEE_RECIPIENT=
# Optional production kit key for higher swap rate limits.

# ─── Paid x402 provider pilot ───────────────────
# Dedicated mainnet signer for AIsa Gateway payments. Never reuse the Arc
# Testnet settlement wallet implicitly; set one of the two signer paths.
KESTREL_X402_EXECUTION_ENABLED=false
KESTREL_X402_WALLET_ADDRESS=
KESTREL_X402_PRIVATE_KEY=
# Operator-only batch authorization. Falls back to CRON_SECRET when empty.
KESTREL_X402_BATCH_SECRET=
# Per-call safety cap. AIsa CoinGecko Simple Price currently quotes 0.008 USDC.
KESTREL_X402_MAX_UNIT_PRICE_USDC=0.01
# Hard cap across all signed authorizations in one batch.
KESTREL_X402_MAX_BATCH_SPEND_USDC=0.20

# ─── Turnkey policy signing (server-side only) ──
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_ORGANIZATION_ID=
TURNKEY_WALLET_ADDRESS=

# ─── Risk provider adapter ──────────────────────
# circle | trm | elliptic
KESTREL_RISK_PROVIDER=circle
TRM_API_KEY=
ELLIPTIC_API_KEY=
ELLIPTIC_API_SECRET=

# ─── Event indexing and reconciliation ─────────
GOLDSKY_GRAPHQL_URL=

# ─── Oracle guards ──────────────────────────────
PYTH_ARC_CONTRACT_ADDRESS=
PYTH_PRICE_FEED_IDS=
CHAINLINK_ARC_FEED_ADDRESS=

# ─── Fallback routing ───────────────────────────
LIFI_API_KEY=
LIFI_INTEGRATOR=kestrel

# ─── Sentry (optional) ──────────────────────────
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=development
SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── Analytics (optional) ───────────────────────
NEXT_PUBLIC_ARC_ANALYTICS_URL=
ARC_ANALYTICS_SALT=

# ─── Internal / CI ──────────────────────────────
ARC_PROXY_SALT=
# Authorizes Vercel's daily fallback and the GitHub Actions worker.
CRON_SECRET=
SENTRY_TEST_TOKEN=
