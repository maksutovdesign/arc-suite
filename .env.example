# ──────────────────────────────────────────────────
# Arc Suite — Environment Variables
# Copy to .env.local and fill in your values
# ──────────────────────────────────────────────────

# ─── Supabase (landing API backend) ──────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# ─── Arc Suite API ───────────────────────────────
# Base URL for the shared API (landing app serves these routes)
# Defaults: production → https://arcsuite-app.vercel.app
#           development → http://127.0.0.1:3100
ARC_SUITE_API_URL=
NEXT_PUBLIC_ARC_SUITE_API_URL=

# Per-app API keys for authenticated requests
ARC_API_KEY=
REP_API_KEY=

# Workspace isolation
ARC_WORKSPACE_ID=

# ─── Treasury auth ───────────────────────────────
ARC_TREASURY_ADMIN_KEY=
ARC_TREASURY_SESSION_SECRET=

# ─── Ecosystem navigation (optional) ────────────
# Falls back to production Vercel URLs if unset
NEXT_PUBLIC_ARC_TREASURY_URL=https://treasury-umber.vercel.app
NEXT_PUBLIC_ARC_REPUTATION_URL=https://reputation-five.vercel.app
NEXT_PUBLIC_ARC_MARKETPLACE_URL=https://marketplace-eosin-eight.vercel.app

# ─── Sentry (optional) ──────────────────────────
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=development
SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── Analytics (optional) ───────────────────────
NEXT_PUBLIC_ARC_ANALYTICS_URL=
ARC_ANALYTICS_SALT=

# ─── Internal / CI ──────────────────────────────
ARC_PROXY_SALT=
CRON_SECRET=
SENTRY_TEST_TOKEN=
